# Create .env from this file. Never commit the real .env file.
OPENROUTER_API_KEY=

# The gateway is loopback-only by default.
OPENROUTER_AGENT_HOST=127.0.0.1
OPENROUTER_AGENT_PORT=3188

# Required if OPENROUTER_AGENT_HOST is changed to a non-loopback address.
# Use a long random value and pass the same value to the MCP process.
OPENROUTER_AGENT_TOKEN=

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=ChatGPT Model Orchestrator

# Safety and cost limits.
MAX_OUTPUT_TOKENS=8192
MAX_PROMPT_CHARS=400000
MAX_COMPARE_MODELS=4

# Optional alias overrides. Leave blank to resolve the newest matching model
# from OpenRouter's live catalog.
DEFAULT_GLM_MODEL=
DEFAULT_GEMINI_MODEL=
DEFAULT_GEMINI_FLASH_MODEL=
DEFAULT_KIMI_MODEL=
DEFAULT_CLAUDE_MODEL=
DEFAULT_DEEPSEEK_MODEL=
DEFAULT_QWEN_MODEL=

# Authenticated remote MCP for ChatGPT web. Create these values in your own
# Auth0 tenant. The audience must exactly match the public MCP URL.
PUBLIC_MCP_URL=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=
AUTH0_REQUIRED_SCOPES=models:invoke
AUTH0_ALLOWED_CLIENT_IDS=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3200

# Your own ngrok reserved domain only. Configure the ngrok authtoken outside
# this repository with `ngrok config add-authtoken`; never put it here.
NGROK_DOMAIN=
